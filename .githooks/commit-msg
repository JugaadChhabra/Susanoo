#!/usr/bin/env bash
# Strips AI attribution trailers (Co-Authored-By: Claude, Claude-Session, "Generated with Claude Code")
# and enforces the commit message format.
set -euo pipefail
. "$(git rev-parse --show-toplevel)/.githooks/_lib.sh"
msg_file="$1"

if has_banned_lines "$msg_file"; then
  tmp="$(mktemp)"; cp "$msg_file" "$tmp"
  while IFS= read -r p; do
    grep -E -i -v -- "$p" "$tmp" > "$tmp.next" || true
    mv "$tmp.next" "$tmp"
  done < <(banned_patterns)
  # drop trailing blank lines
  sed -e ':a' -e '/^\n*$/{$d;N;ba' -e '}' "$tmp" > "$msg_file"; rm -f "$tmp"
  echo "ℹ Removed AI attribution lines from the commit message (project rule, see CLAUDE.md §3)." >&2
fi

subject="$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n1)"
if [ -z "$subject" ]; then echo "✖ Empty commit message." >&2; exit 1; fi
case "$subject" in Merge*|Revert*|fixup!*|squash!*) exit 0;; esac
if ! echo "$subject" | grep -E -q '^(feat|fix|test|docs|chore|refactor|infra)(\([a-z0-9-]+\))?!?: .+'; then
  echo "✖ Commit subject must look like: <type>(<area>): <what changed>" >&2
  echo "  types: feat fix test docs chore refactor infra   e.g. feat(heads): add diagnostician" >&2
  echo "  got:   $subject" >&2
  exit 1
fi
