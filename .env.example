# Copy to .env (never commit .env). Names only here; values come from each service.
# --- Anthropic ---
ANTHROPIC_API_KEY=            # platform key for Susanoo's heads
ANTHROPIC_APP_API_KEY=        # separate key for generated apps (own spend limit)
RUN_COST_CAP_USD=2
GLOBAL_DAILY_CAP_USD=
RUNS_PER_USER_PER_DAY=3
# --- neatlogs ---
NEATLOGS_API_KEY=
# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # backend only
SUPABASE_JWT_SECRET=          # backend only
DATABASE_URL=                 # Postgres connection string (LangGraph PostgresSaver)
# --- GitHub (generated repos) ---
GITHUB_ORG=
GITHUB_TOKEN=                 # repo-create scope, backend only
# --- Domains ---
APP_DOMAIN=                   # e.g. app.example.dev
API_DOMAIN=                   # e.g. api.example.dev
PREVIEW_DOMAIN=               # run-<id>.<PREVIEW_DOMAIN>
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
