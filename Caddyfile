# API_DOMAIN and PREVIEW_DOMAIN (same default as sandbox/docker.py) come from /opt/susanoo/.env, e.g. api.susanoo.jugaadchhabra.dev and
# susanoo.jugaadchhabra.dev. Caddy gets and renews the HTTPS certificates on its own.
{
	# run-<id> previews get a certificate per host at first visit, only once the API confirms the run
	# exists and has a preview recorded. api:8000 is the compose network; the public api domain refuses this.
	on_demand_tls {
		ask http://api:8000/internal/preview-allowed
	}
	# The Host header must match the TLS name, so one run's certificate can't reach another run's container.
	servers {
		strict_sni_host on
	}
}

{$API_DOMAIN} {
	# Flush every write at once so the run's live event stream (SSE) isn't held in a buffer.
	reverse_proxy api:8000 {
		flush_interval -1
	}
}

# Live previews (#4): run-<run_id>.<PREVIEW_DOMAIN> → susanoo-run-<run_id>:8000 on susanoo_sandbox.
# The upstream comes from the host name, so there's no per-run config (labels: docs/integration-points.md).
*.{$PREVIEW_DOMAIN:susanoo.jugaadchhabra.dev} {
	tls {
		on_demand
	}

	@run header_regexp host Host ^run-([a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?)\.
	handle @run {
		reverse_proxy susanoo-run-{re.host.1}:8000
	}

	handle {
		respond "Not found" 404
	}
}
